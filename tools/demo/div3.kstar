# The program behind assets/draw.gif and assets/trace.gif. machines.mjs runs
# it, and the animations show its lines, its machine and its trace.

alphabet B = {0, 1}

# Binary numbers divisible by 3. The state is the remainder so far:
# reading a bit doubles the number and adds the bit.
dfa Div3 over B {
    start  r0
    accept r0
    r0 --0--> r0
    r0 --1--> r1
    r1 --0--> r2
    r1 --1--> r0
    r2 --0--> r1
    r2 --1--> r2
}

print Div3
trace Div3 on "1001"
draw Div3

test Div3 accepts "1001"
test not (Div3 accepts "1000")
