# Chapter 19: the working of the conversions, step by step, the way it is written out
# by hand: eps-closures, the subset construction table, the k-equivalence
# partitions and state elimination. Each ends where the conversion does.

alphabet B = {0, 1}

# An eps-NFA for "the strings that contain 11 or end in 0".
nfa N over B {
    start  s
    accept c, f
    s --eps--> a
    s --eps--> e
    a --0,1--> a
    a --1  --> b
    b --1  --> c
    c --0,1--> c
    e --0,1--> e
    e --0  --> f
}

print std.steps.eps_closures(N)
print ""
print std.steps.subset_table(N)
print ""

# Without eps moves, and with a dead state: after a 0 first, nothing works.
nfa P over B {
    start  p
    accept r
    p --1  --> q
    p --1  --> r
    q --0,1--> q
    q --1  --> r
}
print std.steps.subset_table(P)
print ""

# A DFA with more states than it needs: q1 and q3 do the same job.
dfa M over B {
    start  q0
    accept q2
    q0 --0  --> q1
    q0 --1  --> q3
    q1 --0  --> q2
    q1 --1  --> q0
    q2 --0,1--> q2
    q3 --0  --> q2
    q3 --1  --> q0
}

print std.steps.partitions(M)
print ""
print std.steps.elimination(M)
test equivalent(to_regex(M), M)
