# Chapter 23: a machine as its formal definition. `tuple(M)` writes the
# tuple of the usual textbook definition, with the transition function δ
# as a table.

alphabet B = {0, 1}

# The strings that end in 01.
dfa EndsIn01 over B {
    start  q0
    accept q2
    q0 --0--> q1
    q0 --1--> q0
    q1 --0--> q1
    q1 --1--> q2
    q2 --0--> q1
    q2 --1--> q0
}
print tuple(EndsIn01)
print ""

# The same language, guessing where the 01 starts.
nfa Guess over B {
    start  a
    accept c
    a --0,1--> a
    a --0  --> b
    b --1  --> c
}
print tuple(Guess)
print ""

# A PDA and a Turing machine have a tape or stack alphabet Γ as well.
print tuple(std.pda.anbn("0", "1"))
print ""
print tuple(std.tm.increment())
