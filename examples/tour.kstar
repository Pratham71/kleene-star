# A quick tour of Kleene Star. Run it with:  kstar run examples/tour.kstar

alphabet B = {0, 1}

# A DFA: one transition per state and symbol.
dfa EvenZeros over B {
    start  q0
    accept q0
    q0 --0--> q1
    q0 --1--> q0
    q1 --0--> q0
    q1 --1--> q1
}

# An NFA may have several choices, or none. eps moves look like: a --eps--> b
nfa EndsIn01 over B {
    start  a
    accept c
    a --0,1--> a
    a --0  --> b
    b --1  --> c
}

# A function that builds a whole family of machines:
# binary numbers divisible by n.
fn div_by(n: Int) -> Dfa {
    return dfa over B {
        start  q[0]
        accept q[0]
        for i in 0..n {
            q[i] --0--> q[(2 * i) % n]
            q[i] --1--> q[(2 * i + 1) % n]
        }
    }
}

let r = /(0|1)*01/
let d = minimize(to_dfa(EndsIn01))

print EvenZeros accepts "0011"
print equivalent(d, r)
test div_by(3) accepts "110"

for w in {"", "01", "1101"} {
    if d accepts w {
        print w, "ends in 01"
    }
}

print d
print to_regex(EvenZeros)
draw d
