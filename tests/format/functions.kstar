alphabet B = {0, 1}
# Binary numbers divisible by n.
fn div_by(n:Int)->Dfa{
    return dfa over B { start q[0] accept q[0]
        for i in 0..n { q[i]--0-->q[(2*i)%n]
            q[i] --1--> q[(2 * i + 1) % n] } }
}
fn sign(n: Int) -> Int { if n<0 { return -1 } else if n==0 { return 0 } else { return 1 } }
let words={"","110","111"}
for w in words {if div_by(3) accepts w {print w} else {print "not", w}}
test not(sign(-5)!=-1) and (1+2)*3==9
