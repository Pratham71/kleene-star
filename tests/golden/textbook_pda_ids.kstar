# The PDA for a^(2n) b^(3n), started with Z on the stack: two a's push one
# a, three b's pop it. The trace lists the instantaneous descriptions
# (state, input left, stack) of the accepting run on aabbb.
alphabet AB = {a, b}
pda P over AB {
    start  q0
    accept q5
    q0 --a, Z/Z--> q1
    q0 --a, a/a--> q1
    q0 --eps, Z/Z--> q2
    q0 --eps, a/a--> q2
    q1 --a, Z/aZ--> q0
    q1 --a, a/aa--> q0
    q2 --b, a/a--> q3
    q3 --b, a/a--> q4
    q4 --b, a/eps--> q2
    q2 --eps, Z/Z--> q5
}
trace P on "aabbb"
for w in {"", "aabbb", "aaaabbbbbb", "ab", "aabb", "aabbbb"} {
    print w, P accepts w
}
