# Minimisation by k-equivalence: split the states into accepting and not
# (0-equivalence), then split each group by where its states go, until no
# group splits. Here the groups end as {A, C}, {B}, {D}, {E}.
alphabet B = {0, 1}
dfa M over B {
    start  A
    accept E
    A --0--> B
    A --1--> C
    B --0--> B
    B --1--> D
    C --0--> B
    C --1--> C
    D --0--> B
    D --1--> E
    E --0--> B
    E --1--> C
}
print minimize(M)
test states(minimize(M)) == 4

# An unreachable state is dropped first; then k-equivalence gives
# {a0, a4}, {a1, a7}, {a2}, {a5}, {a6}.
alphabet AB = {a, b}
dfa Q over AB {
    start  a0
    accept a2
    a0 --a--> a1
    a0 --b--> a5
    a1 --a--> a6
    a1 --b--> a2
    a2 --a--> a0
    a2 --b--> a2
    a3 --a--> a2
    a3 --b--> a6
    a4 --a--> a7
    a4 --b--> a5
    a5 --a--> a2
    a5 --b--> a6
    a6 --a--> a6
    a6 --b--> a4
    a7 --a--> a6
    a7 --b--> a2
}
print minimize(Q)
test equivalent(Q, minimize(Q))
