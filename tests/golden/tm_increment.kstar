# Binary increment: run returns the tape, trace shows every step.
alphabet B = {0, 1}

tm Increment over B {
    start  right
    accept done
    right --0/0,R--> right
    right --1/1,R--> right
    right --_/_,L--> carry
    carry --1/0,L--> carry
    carry --0/1,S--> done
    carry --_/1,S--> done
}

print Increment
for w in {"", "0", "1", "1011", "111"} {
    print w, "->", run(Increment, w)
}
trace Increment on "1011"
trace Increment on "12"
