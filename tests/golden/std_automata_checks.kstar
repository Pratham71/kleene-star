# Mistakes the checker finds before anything runs.
alphabet B = {0, 1}
grammar G over B { S -> 0 S 1 | eps }
print std.automata.starts_with("01", B)
print std.automata.exactly(B, 1, 2)
print std.automata.shortest_word(3)
print std.automata.is_finite(G)
print std.automata.count_words(/0/)
print std.automata.prefix(B, "0")
print std.automata.is_finite(/0*/) + 1
