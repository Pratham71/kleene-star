# The standard library, three ways, and its errors.
import std.math as m
from std.math import gcd, div as quotient

print std.math.abs(-5), m.min(2, 3), m.max(2, 3), m.pow(3, 4)
print gcd(12, 18), std.math.lcm(4, 6), quotient(-7, 2), -7 % 2
print m.sqrt(17), m.log2(17), m.factorial(5), m.is_prime(91), m.is_prime(97)
print m.pow(10, 19)
