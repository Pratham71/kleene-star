# is_even and is_odd call each other; the traceback shows the alternation.
fn is_even(n: Int) -> Bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}
fn is_odd(n: Int) -> Bool {
    if n == 0 { return false }
    return is_even(n - 1)
}
print is_even(10), is_odd(7), is_even(7)
print is_even(-1)
