{
  "name": "kleene-star",
  "displayName": "Kleene Star",
  "description": "Highlighting, errors, hover, go to definition and completion for Kleene Star (.kstar) files.",
  "version": "0.2.0",
  "publisher": "kleene-star",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "kstar",
        "aliases": ["Kleene Star", "kstar"],
        "extensions": [".kstar"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kstar",
        "scopeName": "source.kstar",
        "path": "./syntaxes/kstar.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Kleene Star",
      "properties": {
        "kstar.serverPath": {
          "type": "string",
          "default": "kstar-lsp",
          "description": "The kstar-lsp program to run. The default finds it on your PATH; give a full path if it is somewhere else."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
