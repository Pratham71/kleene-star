{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kleene Star",
  "scopeName": "source.kstar",
  "fileTypes": ["kstar"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#regex" },
    { "include": "#transition" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#builtin" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.kstar"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.kstar",
      "patterns": [{ "match": "\\\\[\"\\\\]", "name": "constant.character.escape.kstar" }]
    },
    "regex": {
      "comment": "A `/` after a name, number, `eps` or closing bracket is a PDA slash, not a regex.",
      "begin": "(?<![\\w)\\]])/",
      "end": "/",
      "name": "string.regexp.kstar",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kstar" }]
    },
    "transition": {
      "comment": "The arrows of a transition: `--` and `-->`.",
      "match": "-->|--",
      "name": "keyword.operator.arrow.kstar"
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(alphabet|dfa|nfa|pda|tm|grammar|fn)\\b",
          "name": "storage.type.kstar"
        },
        {
          "match": "\\b(over|start|accept|reject|let|return|if|else|for|in|print|test|draw|trace|on)\\b",
          "name": "keyword.control.kstar"
        },
        {
          "match": "\\b(and|or|not|accepts)\\b",
          "name": "keyword.operator.word.kstar"
        },
        {
          "match": "\\b(true|false|eps)\\b",
          "name": "constant.language.kstar"
        }
      ]
    },
    "type": {
      "match": "\\b(Int|Bool|Str|Alphabet|Dfa|Nfa|Pda|Tm|Regex|Grammar|Set)\\b",
      "name": "entity.name.type.kstar"
    },
    "builtin": {
      "match": "\\b(to_dfa|to_nfa|to_regex|minimize|reduce|remove_eps|rename|union|intersect|difference|complement|concat|star|reverse|equivalent|is_empty|states|len|to_cnf|to_pda|to_grammar|derive|run)(?=\\s*\\()",
      "name": "support.function.builtin.kstar"
    },
    "number": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.kstar"
    },
    "operator": {
      "match": "->|==|!=|<=|>=|\\.\\.|[+\\-*%<>=|]",
      "name": "keyword.operator.kstar"
    }
  }
}
